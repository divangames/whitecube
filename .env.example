# Скопируйте в .env и заполните своими значениями. .env не коммитить.

# --- Telegram (основной канал заявок) ---
# Создайте бота через @BotFather и вставьте токен.
TELEGRAM_BOT_TOKEN=
# chat_id чата/группы куда слать заявки.
TELEGRAM_CHAT_ID=

# --- SMTP NotiSend (опционально, как второй канал) ---
NOTISEND_SMTP_HOST=smtp.msndr.net
NOTISEND_SMTP_PORT=587
NOTISEND_SMTP_SECURE=false
# Для 465:
# NOTISEND_SMTP_PORT=465
# NOTISEND_SMTP_SECURE=true
NOTISEND_SMTP_USER=
NOTISEND_SMTP_PASS=
MAIL_TO=manager@cdek-ozon.ru
MAIL_FROM=

# API порт
PORT=3001

# Если API на другом домене (прод)
# VITE_CONTACT_API=https://api.ваш-сайт.ru

# --- Frontend direct Telegram (без сервера; токен будет виден в JS) ---
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

